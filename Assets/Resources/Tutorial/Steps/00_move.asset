  dialogueText: "<color=#FFD700><b>WASD</b></color>\uB85C \uAC78\uC5B4 \uB2E4\uB2D0
    \uC218 \uC788\uC5B4\uC694.\n<color=#FFD700><b>Shift</b></color>\uB97C \uB204\uB974\uACE0
    \uC788\uC73C\uBA74 \uB2EC\uB9AC\uACE0, <color=#FFD700><b>Space</b></color>\uB97C
    \uB204\uB974\uBA74 \uAD6C\uB974\uBA74\uC11C \uD53C\uD560 \uC218 \uC788\uC5B4\uC694.
