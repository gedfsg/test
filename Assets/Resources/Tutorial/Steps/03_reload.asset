  dialogueText: "\uD0C4\uCC3D\uC774 \uAC70\uC758 \uBE44\uC5C8\uC5B4\uC694! <color=#FFD700><b>R</b></color>\uC744
    \uB204\uB974\uBA74 \uC7AC\uC7A5\uC804\uD560 \uC218 \uC788\uC5B4\uC694.\n\uC7AC\uC7A5\uC804\uD558\uB294
