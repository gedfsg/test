  dialogueText: "\uB4DC\uB514\uC5B4 \uB9C8\uC9C0\uB9C9 \uB0A0\uC774\uC5D0\uC694!
    \uC9C4\uD589\uB960\uC744 100%\uAE4C\uC9C0 \uCC44\uC6B0\uBA74 \uD5EC\uB9AC\uCF65\uD130\uB85C
